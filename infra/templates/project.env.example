# Copiază ca ~/proiecte/__NAME__/.env pe server, completează, apoi: chmod 600 .env
# Secrete: openssl rand -hex 32   (hex = fără probleme de escaping în URL-uri)
# NU pune .env în Git. Tag-ul imaginii NU se pune aici: îl dă workflow-ul (TAG=<sha>).

POSTGRES_USER=__NAME__
POSTGRES_PASSWORD=
POSTGRES_DB=__NAME__

JWT_SECRET=
